# shellcheck shell=bash
# Versões fixadas do ambiente de bug bounty com REA.
#
# Regra: nenhum download é usado sem SHA-256 conferido. Onde o hash não pode
# ser conhecido de antemão (página de release do fornecedor), a variável fica
# vazia e o script ABORTA até você preenchê-la. Veja README.md, seção
# "Como obter os hashes".

# --- Sistema base -------------------------------------------------------------
# Debian 13 "trixie" (stable). Ubuntu entrega Chromium só via snap, o que
# atrapalha o uso por linha de comando; por isso Debian.
BB_EXPECTED_OS_ID="debian"
BB_EXPECTED_OS_VERSION_ID="13"

# --- Node.js / REA ------------------------------------------------------------
# REA exige Node ^22.19 || ^24.11 || >=26. 24.18.0 é o toolchain do próprio repo.
NODE_VERSION="24.18.0"
NODE_DIST_BASE="https://nodejs.org/dist/v${NODE_VERSION}"
NODE_TARBALL="node-v${NODE_VERSION}-linux-x64.tar.xz"
# O hash vem de SHASUMS256.txt (verificado com GPG se BB_NODE_GPG_VERIFY=1).
BB_NODE_GPG_VERIFY="1"

REA_VERSION="6.0.0"

# --- Android: JADX headless (pin auditado em src/android/JadxRelease.ts) ------
JADX_MCP_VERSION="0.7.1"
JADX_MCP_URL="https://github.com/1013503897/jadx-headless-mcp/releases/download/v${JADX_MCP_VERSION}/jadx-headless-mcp-${JADX_MCP_VERSION}-all.jar"
JADX_MCP_SHA256="6e5eacf500b64292bfb73c49797c1958f6ee44646e43e868039ae7feb573ff75"

# --- Capturas: mitmproxy (REA aceita exatamente 12.2.3 no Linux) --------------
MITMPROXY_VERSION="12.2.3"

# --- Nativo: Ghidra (REA aceita 12.1.x; verificado com 12.1.4 + JDK 21) -------
GHIDRA_VERSION="12.1.4"
# Preencha com a URL exata do .zip e o SHA-256 publicados na página de release:
# https://github.com/NationalSecurityAgency/ghidra/releases/tag/Ghidra_12.1.4_build
GHIDRA_ZIP_URL=""
GHIDRA_SHA256=""

# --- ELF / crashes: pwntools (versões exigidas em docs/binary-diagnostics.md) -
PWNTOOLS_VERSION="4.15.0"
PYELFTOOLS_VERSION="0.33"
UNICORN_VERSION="2.1.2"

# --- Crashes com GDB/pwndbg (opcional; docs/recorded-crashes.md) --------------
PWNDBG_VERSION="2026.09.15"
# Tarball portátil x86_64 da release oficial do pwndbg + SHA-256 da release.
PWNDBG_TARBALL_URL=""
PWNDBG_SHA256=""

# --- Firmware (docs/firmware-analysis.md) -------------------------------------
BINWALK_VERSION="3.1.0"      # instalado via cargo --locked
UNBLOB_VERSION="26.6.4"      # instalado via pip em venv isolado

# --- Recuperação de JS: Wakaru (docs/javascript-recovery.md) ------------------
WAKARU_VERSION="1.13.0"
# Binário oficial Linux x64 da release 1.13.0 + SHA-256.
WAKARU_URL=""
WAKARU_SHA256=""

# --- Layout no servidor -------------------------------------------------------
BB_TOOLS_DIR="/opt/bb-tools"        # root:root 755 – usuário não altera ferramentas
BB_WORK_DIR="/srv/bb"               # hunter:hunter 700 – dados de alvos
BB_USER="hunter"
BB_ENV_FILE="/etc/bb/rea-bb.env"    # root:hunter 640
